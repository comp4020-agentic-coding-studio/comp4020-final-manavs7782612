---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { marked } from "marked";

export const prerender = false;

// Read relative to the process's cwd (repo root both locally and in the
// Docker image — see Dockerfile), not import.meta.url: the built file lives
// under dist/server/pages/, so a relative-to-source path would look there.
const readmeMarkdown = readFileSync(join(process.cwd(), "README.md"), "utf8");
const readmeHtml = marked.parse(readmeMarkdown);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>About: Canberra Sector</title>
    <link rel="stylesheet" href="/atc.css" />
    <style>
      article :global(h1) {
        font-size: 1.15rem;
        font-weight: 700;
      }
      article :global(h2) {
        margin-top: 2rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border);
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-dim);
      }
      article :global(code) {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.1em 0.35em;
      }
      article :global(li) {
        margin-bottom: 0.4rem;
      }
    </style>
  </head>
  <body>
    <main>
      <header class="bar">
        <span class="dim">About</span>
        <nav><a href="/">Pilot</a><a href="/tower/">Tower</a></nav>
      </header>
      <article set:html={readmeHtml} />
    </main>
  </body>
</html>
