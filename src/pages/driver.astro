---
export const prerender = false;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Slotlock: driver</title>
    <link rel="stylesheet" href="/app.css" />
  </head>
  <body>
    <main>
      <header class="bar">
        <h1>Slotlock: driver</h1>
        <nav>
          <span id="conn" class="dim" role="status">CONNECTING</span>
          <a href="/dock/">Dock view</a>
          <a href="/readme/">About</a>
          <button type="button" id="logout">Log out</button>
        </nav>
      </header>

      <noscript><p class="alert">This app needs JavaScript: slots update live.</p></noscript>

      <div class="grid">
        <section class="panel">
          <h2>Your slots</h2>
          <div id="mine"></div>
          <p class="dim" id="no-mine" hidden>You have no slots yet.</p>
        </section>

        <section class="panel">
          <h2>Open slots you're compliant for</h2>
          <p class="dim">
            A dispatcher claims these for you — this view is read-only.
          </p>
          <div id="open"></div>
          <p class="dim" id="no-open" hidden>No open slots fit your remaining hours right now.</p>
        </section>
      </div>
    </main>

    <script src="/driver.js" is:inline></script>
  </body>
</html>
