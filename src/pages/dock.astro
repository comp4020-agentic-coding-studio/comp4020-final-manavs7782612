<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Slotlock: dock status</title>
    <link rel="stylesheet" href="/app.css" />
  </head>
  <body>
    <main>
      <header class="bar">
        <h1>Dock status</h1>
        <nav>
          <span id="conn" class="dim" role="status">CONNECTING</span>
          <a href="/">Log in</a>
          <a href="/readme/">About</a>
        </nav>
      </header>

      <p class="dim">
        Public, anonymous, live. No names, no driver details — fill status
        only.
      </p>

      <noscript><p class="alert">This app needs JavaScript: status updates live.</p></noscript>

      <section class="panel">
        <div id="docks"></div>
      </section>
    </main>

    <script src="/dock.js" is:inline></script>
  </body>
</html>
