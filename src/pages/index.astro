---
import { AIRPORT_INFO, AIRPORTS, SECTOR, VIEW_RADIUS_KM } from "../lib/airports";
import { getOrSetUserId } from "../lib/identity";

export const prerender = false;

// A page render is the only place an identity cookie is minted.
getOrSetUserId(Astro.cookies, Astro.url.protocol === "https:");
const world = JSON.stringify({ sector: SECTOR, airports: AIRPORT_INFO, view: VIEW_RADIUS_KM });
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Canberra Sector: pilot</title>
    <link rel="stylesheet" href="/atc.css" />
  </head>
  <body>
    <main>
      <header class="bar">
        <h1>Canberra Sector</h1>
        <nav>
          <span id="conn" class="dim" role="status">CONNECTING</span>
          <a href="/tower/">Tower</a>
          <a href="/readme/">About</a>
        </nav>
      </header>

      <noscript><p class="alert">This app needs JavaScript: the sky is live.</p></noscript>

      <div class="grid">
        <section class="panel" id="join-panel" hidden>
          <h2>Join as a pilot</h2>
          <p class="dim">Pick the airport you start parked at. You get a callsign.</p>
          <div class="keys">
            <label for="start" class="dim">Start at</label>
            <select id="start">
              {AIRPORTS.map((code) => <option value={code}>{code} {AIRPORT_INFO[code].name}</option>)}
            </select>
            <button type="button" class="go" data-act="join">Join</button>
          </div>
        </section>

        <section class="panel" id="flight-panel" hidden>
          <h2>Your flight</h2>
          <div class="strip" id="strip-callsign"></div>
          <div id="strip-status"></div>
          <div class="row"><span class="dim">HDG</span><span id="strip-heading"></span><span class="dim">SPD</span><span id="strip-speed"></span></div>
          <div class="row"><span class="dim">NEAREST</span><span id="strip-nearest"></span></div>
          <div class="row"><span class="dim">TOWER</span><span id="strip-advisory">no advice</span></div>
          <div class="keys">
            <button type="button" data-act="steer" data-turn="-1" data-flying>&#9664; Left 15</button>
            <button type="button" data-act="steer" data-turn="1" data-flying>Right 15 &#9654;</button>
            <button type="button" data-act="steer" data-speed="-1" data-flying>Slower</button>
            <button type="button" data-act="steer" data-speed="1" data-flying>Faster</button>
          </div>
          <div class="keys">
            <button type="button" class="go" id="btn-takeoff" data-act="request-takeoff">Request takeoff</button>
            <select id="land-at" aria-label="Airport to land at">
              {AIRPORTS.map((code) => <option value={code}>{code}</option>)}
            </select>
            <button type="button" class="go" id="btn-landing" data-act="request-landing">Request landing</button>
            <button type="button" data-act="leave">Leave</button>
          </div>
        </section>

        <section class="panel">
          <h2>Traffic</h2>
          <div id="conflict" class="dim">no traffic data yet</div>
          <div id="nearby"></div>
          <p class="dim" id="range-note"></p>
        </section>

        <section class="panel">
          <h2>Runways</h2>
          <div id="runways"></div>
        </section>
      </div>

      <p id="msg" role="status" aria-live="polite"></p>

      <section class="panel">
        <h2>Scope</h2>
        <svg id="scope"></svg>
      </section>
    </main>

    <script type="application/json" id="world" is:inline set:html={world} />
    <script src="/scope.js" is:inline></script>
    <script src="/pilot.js" is:inline></script>
  </body>
</html>
